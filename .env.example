# Database (TimescaleDB)
DATABASE_URL=postgresql://openswarm:openswarm@localhost:5432/openswarm

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# OpenSwarm Control Plane
OPENSWARM_ADDR=http://localhost:9090

# OpenClaw instances (comma-separated host:port)
OPENCLAW_INSTANCES=localhost:18789,localhost:18790,localhost:18791
OPENCLAW_TOKEN=openswarm-secret

# Node environment
NODE_ENV=development

# Frontend → Control Plane
NEXT_PUBLIC_CONTROLPLANE_URL=http://localhost:9090
