{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aria.babel/spec/v1",
  "title": "Babel Tool Specification",
  "description": "Schema for ARIA Babel tool specification files (.babel.yaml)",
  "type": "object",
  "required": ["babel_version", "id", "name", "description", "interface", "implementation", "execution"],
  "additionalProperties": false,
  "properties": {
    "babel_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Babel specification version (e.g. '1.0')"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9_]+)*$",
      "description": "Unique tool identifier in reverse domain notation (e.g. com.aria.tools.weather)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable tool name"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What the tool does — used as LLM description when registering with AG2"
    },
    "interface": {
      "type": "object",
      "required": ["inputs", "output"],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/parameter" },
          "description": "Input parameters the tool accepts"
        },
        "output": {
          "$ref": "#/definitions/outputType",
          "description": "Return type of the tool"
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["language", "entry_point", "function"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "enum": ["python"],
          "description": "Implementation language (only python supported in v1.0)"
        },
        "entry_point": {
          "type": "string",
          "description": "Relative path to the implementation file from this spec's directory"
        },
        "function": {
          "type": "string",
          "description": "Name of the function to call in the entry_point module"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "pip packages required (e.g. ['requests', 'httpx>=0.24'])"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ag2", "raw_python"]
      },
      "default": ["ag2", "raw_python"],
      "description": "Compilation targets this tool supports"
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["input"],
            "additionalProperties": false,
            "properties": {
              "input": { "type": "object" },
              "expect": { "type": "object" },
              "expect_keys": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Assert these keys exist in the output"
              },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Max execution time in seconds"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Number of retry attempts on failure"
        },
        "async": {
          "type": "boolean",
          "default": false,
          "description": "Whether the tool runs asynchronously"
        },
        "error_format": {
          "type": "object",
          "description": "Expected error return structure",
          "properties": {
            "type": { "type": "string" },
            "fields": {
              "type": "array",
              "items": { "$ref": "#/definitions/parameter" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "version": { "type": "string", "default": "1.0.0" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "api_keys_required": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Environment variable names required (e.g. ['OPENWEATHERMAP_API_KEY'])"
        },
        "homepage": { "type": "string" }
      }
    }
  },
  "definitions": {
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "float", "boolean", "enum", "array", "object"]
        },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": true },
        "default": {},
        "values": {
          "type": "array",
          "description": "Valid values for enum type parameters"
        },
        "items": {
          "description": "Item type descriptor for array parameters"
        },
        "fields": {
          "type": "array",
          "description": "Sub-fields for object type parameters"
        }
      }
    },
    "outputType": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "integer", "float", "boolean", "array", "object"]
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/parameter" },
          "description": "Sub-fields for object output types"
        },
        "items": {
          "description": "Item type for array output"
        }
      }
    }
  }
}
