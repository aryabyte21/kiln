{
  "name": "py-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/py-api/app",
  "projectType": "application",
  "targets": {
    "dev": {
      "command": "../../.venv/bin/python -m uvicorn app.main:app --reload --port 8000 --host 0.0.0.0",
      "options": {
        "cwd": "apps/py-api"
      }
    },
    "lint": {
      "command": "../../.venv/bin/python -m ruff check .",
      "options": {
        "cwd": "apps/py-api"
      }
    },
    "build": {
      "command": "../../.venv/bin/python -m compileall app",
      "options": {
        "cwd": "apps/py-api"
      }
    },
    "test": {
      "command": "../../.venv/bin/python -m pytest",
      "options": {
        "cwd": "apps/py-api"
      }
    }
  },
  "tags": ["scope:backend", "lang:python", "type:app"]
}
